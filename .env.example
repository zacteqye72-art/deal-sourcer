# Claudio environment configuration

# HTTP / WS port for the local server
PORT=8080

# Path to the Claude CLI binary. Uses Max-subscription auth, no API key needed.
# Leave the default if `claude` is on your PATH.
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-sonnet-4-6

# NetEaseCloudMusicApi (https://github.com/Binaryify/NeteaseCloudMusicApi).
# Run it locally and point Claudio at it.
NCM_BASE_URL=http://127.0.0.1:3000

# Fish Audio TTS (https://fish.audio)
FISH_API_KEY=
FISH_VOICE_ID=

# OpenWeather (https://openweathermap.org/api)
OPENWEATHER_API_KEY=
OPENWEATHER_LAT=39.9042
OPENWEATHER_LON=116.4074

# Feishu / Lark — for reading your calendar
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_USER_ACCESS_TOKEN=

# UPnP renderer (your living-room amp, e.g. Naim Mu-so).
# Leave UPNP_RENDERER_URL empty to auto-discover via SSDP on the LAN.
UPNP_RENDERER_URL=
